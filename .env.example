# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myhealthcare?schema=public"

# Redis Cache & Sessions
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="myhealthcare_super_secure_jwt_secret_key_2026_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="myhealthcare_super_secure_refresh_secret_key_2026_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateway (Stripe / Razorpay)
PAYMENT_PROVIDER=stripe
PAYMENT_KEY_ID=pk_test_sample_key_123456789
PAYMENT_KEY_SECRET=sk_test_sample_secret_987654321
PAYMENT_WEBHOOK_SECRET=whsec_sample_secret_abc123

# Email Service (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=sample_mailtrap_user
EMAIL_PASSWORD=sample_mailtrap_password
EMAIL_FROM="noreply@myhealthcare.internal"

# Cloud Storage (Cloudinary or S3 compatible)
CLOUDINARY_CLOUD_NAME=sample_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=sample_secret_key_abcdef

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
