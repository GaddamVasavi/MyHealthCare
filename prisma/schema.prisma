generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MedicationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LabStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NET_BANKING
  CASH
  INSURANCE_DIRECT
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum NotificationType {
  APPOINTMENT
  PRESCRIPTION
  LAB_RESULT
  BILLING
  SYSTEM
  HEALTH_REMINDER
}

enum DocumentCategory {
  LAB_REPORT
  PRESCRIPTION
  SCAN_IMAGING
  DISCHARGE_SUMMARY
  INSURANCE_DOC
  OTHER
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ----------------------------------------------------
// USER & AUTHENTICATION
// ----------------------------------------------------

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String
  role               UserRole       @default(PATIENT)
  isEmailVerified    Boolean        @default(false)
  emailVerifyToken   String?
  resetPasswordToken String?
  resetPasswordExp   DateTime?
  isActive           Boolean        @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  // Relations
  patient            Patient?
  doctor             Doctor?
  sessions           Session[]
  notifications      Notification[]
  auditLogs          AuditLog[]     @relation("UserAuditLogs")

  @@index([email])
  @@index([role])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

// ----------------------------------------------------
// PATIENT & HEALTH PROFILE
// ----------------------------------------------------

model Patient {
  id                String             @id @default(uuid())
  userId            String             @unique
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            Gender
  phone             String
  profileImage      String?
  bloodGroup        BloodGroup         @default(UNKNOWN)
  heightCm          Float?
  weightKg          Float?
  occupation        String?
  maritalStatus     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  address           Address?
  emergencyContact  EmergencyContact?
  healthProfile     HealthProfile?
  allergies         Allergy[]
  conditions        MedicalCondition[]
  medicalRecords    MedicalRecord[]
  vitalSigns        VitalSign[]
  appointments      Appointment[]
  prescriptions     Prescription[]
  medications       Medication[]
  labOrders         LabOrder[]
  medicalDocuments  MedicalDocument[]
  invoices          Invoice[]
  insurancePolicies InsurancePolicy[]
  insuranceClaims   InsuranceClaim[]

  @@index([userId])
  @@index([phone])
  @@index([lastName, firstName])
}

model Address {
  id         String   @id @default(uuid())
  patientId  String   @unique
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id           String   @id @default(uuid())
  patientId    String   @unique
  contactName  String
  relationship String
  phone        String
  altPhone     String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model HealthProfile {
  id                   String   @id @default(uuid())
  patientId            String   @unique
  smokingStatus        String?  // NEVER, FORMER, OCCASIONAL, REGULAR
  alcoholConsumption  String?  // NEVER, OCCASIONAL, MODERATE, FREQUENT
  exerciseHabits       String?  // SEDENTARY, LIGHT, MODERATE, ACTIVE
  dietaryPreferences   String?  // VEGETARIAN, NON_VEGETARIAN, VEGAN, EGGETARIAN, OTHER
  chronicDiseases      String?  // Comma-separated or text summary
  previousSurgeries    String?  // Notes on past surgeries
  familyMedicalHistory String?  // Family history notes
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Allergy {
  id          String   @id @default(uuid())
  patientId   String
  allergen    String
  reaction    String
  severity    String   // MILD, MODERATE, SEVERE
  diagnosedOn DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model MedicalCondition {
  id           String    @id @default(uuid())
  patientId    String
  name         String
  icdCode      String?
  status       String    // ACTIVE, RESOLVED, CHRONIC
  diagnosedOn  DateTime?
  resolvedOn   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// ----------------------------------------------------
// DOCTOR & SPECIALIZATION
// ----------------------------------------------------

model Specialization {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors     Doctor[]
}

model Doctor {
  id               String               @id @default(uuid())
  userId           String               @unique
  specializationId String
  firstName        String
  lastName         String
  phone            String
  licenseNumber    String               @unique
  qualifications   String               // e.g. "MBBS, MD (Cardiology)"
  experienceYears  Int                  @default(0)
  consultationFee  Decimal              @db.Decimal(10, 2)
  biography        String?
  clinicName       String?
  clinicAddress    String?
  languages        String?              // e.g. "English, Hindi, Bengali"
  profileImage     String?
  rating           Float                @default(5.0)
  totalReviews     Int                  @default(0)
  isAvailable      Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  // Relations
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization   Specialization       @relation(fields: [specializationId], references: [id])
  availabilities   DoctorAvailability[]
  schedules        DoctorSchedule[]
  leaves           DoctorLeave[]
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  labOrders        LabOrder[]

  @@index([userId])
  @@index([specializationId])
  @@index([lastName, firstName])
}

model DoctorAvailability {
  id         String    @id @default(uuid())
  doctorId   String
  dayOfWeek  DayOfWeek
  startTime  String    // e.g. "09:00"
  endTime    String    // e.g. "17:00"
  slotDurationMinutes Int @default(30)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  doctor     Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime, endTime])
  @@index([doctorId])
}

model DoctorSchedule {
  id          String   @id @default(uuid())
  doctorId    String
  date        DateTime @db.Date
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date])
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

// ----------------------------------------------------
// APPOINTMENTS
// ----------------------------------------------------

model Appointment {
  id             String            @id @default(uuid())
  appointmentNumber String         @unique
  patientId      String
  doctorId       String
  appointmentDate DateTime         @db.Date
  startTime      String            // e.g. "10:00"
  endTime        String            // e.g. "10:30"
  status         AppointmentStatus @default(REQUESTED)
  reason         String?
  notes          String?
  cancellationReason String?
  consultationFee Decimal          @db.Decimal(10, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  patient        Patient           @relation(fields: [patientId], references: [id])
  doctor         Doctor            @relation(fields: [doctorId], references: [id])
  medicalRecord  MedicalRecord?
  invoice        Invoice?

  // Strict double-booking prevention constraint
  @@unique([doctorId, appointmentDate, startTime])
  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
}

// ----------------------------------------------------
// MEDICAL RECORDS, VITALS, DIAGNOSES & NOTES
// ----------------------------------------------------

model MedicalRecord {
  id             String          @id @default(uuid())
  recordNumber   String          @unique
  patientId      String
  doctorId       String
  appointmentId  String?         @unique
  visitDate      DateTime        @default(now())
  chiefComplaint String
  historyOfIllness String?
  assessment     String?
  treatmentPlan  String?
  followUpDate   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  patient        Patient         @relation(fields: [patientId], references: [id])
  doctor         Doctor          @relation(fields: [doctorId], references: [id])
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  vitalSigns     VitalSign[]
  diagnoses      Diagnosis[]
  clinicalNotes  ClinicalNote[]
  treatments     Treatment[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]

  @@index([patientId])
  @@index([doctorId])
  @@index([visitDate])
}

model VitalSign {
  id                  String         @id @default(uuid())
  patientId           String
  medicalRecordId     String?
  recordedAt          DateTime       @default(now())
  heightCm            Float?
  weightKg            Float?
  bmi                 Float?
  systolicBp          Int?           // mmHg
  diastolicBp         Int?           // mmHg
  heartRateBpm        Int?           // bpm
  respiratoryRate     Int?           // breaths/min
  temperatureCelsius  Float?         // C
  oxygenSaturationPct Float?         // SpO2 %
  bloodGlucoseMgDl    Float?         // mg/dL
  recordedByRole      UserRole       @default(PATIENT)
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  patient             Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicalRecord       MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  @@index([patientId, recordedAt])
}

model Diagnosis {
  id              String        @id @default(uuid())
  medicalRecordId String
  code            String?       // ICD-10 Code
  description     String
  type            String        @default("PRIMARY") // PRIMARY, SECONDARY, DIFFERENTIAL
  severity        String?       // MILD, MODERATE, ACUTE, CRITICAL
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([medicalRecordId])
}

model ClinicalNote {
  id              String        @id @default(uuid())
  medicalRecordId String
  noteType        String        @default("PROGRESS") // SOAP, PROGRESS, CONSULTATION
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([medicalRecordId])
}

model Treatment {
  id              String        @id @default(uuid())
  medicalRecordId String
  treatmentName   String
  description     String?
  startDate       DateTime?
  endDate         DateTime?
  status          String        @default("COMPLETED")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([medicalRecordId])
}

// ----------------------------------------------------
// PRESCRIPTIONS & MEDICATIONS
// ----------------------------------------------------

model Prescription {
  id                String             @id @default(uuid())
  prescriptionNumber String            @unique
  patientId         String
  doctorId          String
  medicalRecordId   String?
  issuedDate        DateTime           @default(now())
  validUntil        DateTime?
  generalAdvice     String?
  followUpDate      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  patient           Patient            @relation(fields: [patientId], references: [id])
  doctor            Doctor             @relation(fields: [doctorId], references: [id])
  medicalRecord     MedicalRecord?     @relation(fields: [medicalRecordId], references: [id])
  items             PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicineName   String
  form           String       @default("TABLET") // TABLET, CAPSULE, SYRUP, INJECTION, OINTMENT
  dosage         String       // e.g. "500 mg"
  frequency      String       // e.g. "1-0-1" or "Twice daily after meals"
  durationDays   Int          @default(7)
  instructions   String?      // e.g. "Take after breakfast"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model Medication {
  id              String           @id @default(uuid())
  patientId       String
  name            String
  dosage          String
  frequency       String
  durationDays    Int?
  startDate       DateTime         @default(now())
  endDate         DateTime?
  status          MedicationStatus @default(ACTIVE)
  prescribedBy    String?
  reminderTimes   String?          // JSON array e.g. ["08:00", "20:00"]
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
}

// ----------------------------------------------------
// LABORATORY & DIAGNOSTICS
// ----------------------------------------------------

model LabTest {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  category    String         // HEMATOLOGY, BIOCHEMISTRY, RADIOLOGY, PATHOLOGY, IMMUNOLOGY
  description String?
  price       Decimal        @db.Decimal(10, 2)
  normalRange String?
  unit        String?
  sampleType  String?        // BLOOD, URINE, SWAB, TISSUE
  tatHours    Int            @default(24) // Turnaround time
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  labResults  LabResult[]
}

model LabOrder {
  id            String         @id @default(uuid())
  orderNumber   String         @unique
  patientId     String
  doctorId      String
  medicalRecordId String?
  status        LabStatus      @default(ORDERED)
  clinicalNotes String?
  orderedDate   DateTime       @default(now())
  sampleCollectedDate DateTime?
  completedDate DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  results       LabResult[]
  invoice       Invoice?

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model LabResult {
  id            String    @id @default(uuid())
  labOrderId    String
  labTestId     String
  testName      String
  resultValue   String
  normalRange   String?
  unit          String?
  isAbnormal    Boolean   @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?
  comments      String?
  reportFileUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  labOrder      LabOrder  @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTest       LabTest   @relation(fields: [labTestId], references: [id])

  @@index([labOrderId])
  @@index([labTestId])
}

// ----------------------------------------------------
// MEDICAL DOCUMENTS
// ----------------------------------------------------

model MedicalDocument {
  id          String           @id @default(uuid())
  patientId   String
  title       String
  category    DocumentCategory @default(OTHER)
  fileUrl     String
  fileName    String
  fileSize    Int
  mimeType    String
  description String?
  uploadedBy  String           // User ID or name
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([category])
}

// ----------------------------------------------------
// BILLING, PAYMENTS & INSURANCE
// ----------------------------------------------------

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  patientId     String
  appointmentId String?       @unique
  labOrderId    String?       @unique
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @default(0.00) @db.Decimal(10, 2)
  discount      Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0.00) @db.Decimal(10, 2)
  dueAmount     Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient       Patient       @relation(fields: [patientId], references: [id])
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  labOrder      LabOrder?     @relation(fields: [labOrderId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]

  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                 String        @id @default(uuid())
  paymentNumber      String        @unique
  invoiceId          String
  amount             Decimal       @db.Decimal(10, 2)
  method             PaymentMethod @default(CREDIT_CARD)
  status             PaymentStatus @default(PENDING)
  transactionRef     String?       @unique
  gatewayResponse    String?
  paidAt             DateTime?
  failureReason      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  invoice            Invoice       @relation(fields: [invoiceId], references: [id])
  refunds            Refund[]

  @@index([invoiceId])
  @@index([status])
}

model Refund {
  id           String        @id @default(uuid())
  refundNumber String        @unique
  paymentId    String
  amount       Decimal       @db.Decimal(10, 2)
  reason       String
  status       PaymentStatus @default(PENDING)
  processedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  payment      Payment       @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model InsuranceProvider {
  id            String            @id @default(uuid())
  name          String            @unique
  contactNumber String
  email         String
  address       String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  policies      InsurancePolicy[]
}

model InsurancePolicy {
  id             String            @id @default(uuid())
  patientId      String
  providerId     String
  policyNumber   String            @unique
  policyType     String            // INDIVIDUAL, FAMILY, COMPREHENSIVE
  coverageAmount Decimal           @db.Decimal(12, 2)
  startDate      DateTime          @db.Date
  expirationDate DateTime          @db.Date
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider       InsuranceProvider @relation(fields: [providerId], references: [id])
  claims         InsuranceClaim[]

  @@index([patientId])
  @@index([providerId])
}

model InsuranceClaim {
  id             String          @id @default(uuid())
  claimNumber    String          @unique
  patientId      String
  policyId       String
  claimAmount    Decimal         @db.Decimal(10, 2)
  approvedAmount Decimal?        @db.Decimal(10, 2)
  status         ClaimStatus     @default(SUBMITTED)
  claimReason    String
  denialReason   String?
  submittedDate  DateTime        @default(now())
  adjudicatedDate DateTime?
  documentsUrl   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patient        Patient         @relation(fields: [patientId], references: [id])
  policy         InsurancePolicy @relation(fields: [policyId], references: [id])

  @@index([patientId])
  @@index([policyId])
  @@index([status])
}

// ----------------------------------------------------
// NOTIFICATIONS & AUDIT LOGS & SYSTEM
// ----------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  linkUrl   String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entity     String      // e.g. "MedicalRecord", "Appointment", "User"
  entityId   String?
  details    String?     // JSON or summary description
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user       User?       @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
