PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myhealthcare_db?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_ACCESS_SECRET="enterprise_super_secret_jwt_access_key_replace_in_production_2026"
JWT_REFRESH_SECRET="enterprise_super_secret_jwt_refresh_key_replace_in_production_2026"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Email Delivery (Mock / SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user_placeholder"
SMTP_PASS="smtp_pass_placeholder"
EMAIL_FROM="no-reply@myhealthcare.com"

# Logging
LOG_LEVEL="info"
