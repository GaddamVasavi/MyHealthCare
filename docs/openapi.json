{
  "openapi": "3.0.3",
  "info": {
    "title": "MyHealthCare Platform API",
    "description": "Enterprise-grade REST API documentation for MyHealthCare Personalized Healthcare Management Platform.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/auth/register/patient": {
      "post": {
        "summary": "Register a new patient",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "firstName", "lastName", "dateOfBirth", "gender", "phone"],
                "properties": {
                  "email": { "type": "string", "example": "patient@example.com" },
                  "password": { "type": "string", "example": "Password@123" },
                  "firstName": { "type": "string", "example": "John" },
                  "lastName": { "type": "string", "example": "Doe" },
                  "dateOfBirth": { "type": "string", "example": "1990-01-01" },
                  "gender": { "type": "string", "enum": ["MALE", "FEMALE", "OTHER"] },
                  "phone": { "type": "string", "example": "+1-555-0199" },
                  "bloodGroup": { "type": "string", "example": "B_POSITIVE" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Patient successfully registered" },
          "409": { "description": "Email already in use" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user and issue JWT access and refresh tokens",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "john.doe@patient.com" },
                  "password": { "type": "string", "example": "Password@123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid email or password" }
        }
      }
    },
    "/appointments/available-slots": {
      "get": {
        "summary": "Query available doctor consultation time slots for a specific date",
        "tags": ["Appointments"],
        "parameters": [
          { "name": "doctorId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "date", "in": "query", "required": true, "schema": { "type": "string", "example": "2026-09-01" } }
        ],
        "responses": {
          "200": { "description": "Available time slots" }
        }
      }
    },
    "/appointments": {
      "post": {
        "summary": "Book a doctor consultation with double-booking prevention",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["doctorId", "appointmentDate", "startTime", "endTime", "reason"],
                "properties": {
                  "doctorId": { "type": "string" },
                  "appointmentDate": { "type": "string", "example": "2026-09-01" },
                  "startTime": { "type": "string", "example": "10:00" },
                  "endTime": { "type": "string", "example": "10:30" },
                  "reason": { "type": "string", "example": "Annual preventive wellness checkup" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Appointment confirmed and invoice created" },
          "409": { "description": "Slot already taken" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
